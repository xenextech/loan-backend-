# Copy to .env and fill in. Never commit a filled-in copy — .env is gitignored.

NODE_ENV=development
PORT=3001

# Runtime — pg.Pool via @prisma/adapter-pg (transaction-mode pooler)
DATABASE_URL=postgresql://user:password@host:6543/postgres?pgbouncer=true&connection_limit=1
# Migrations — Prisma CLI uses this directly (session-mode pooler, bypasses pgbouncer)
DIRECT_URL=postgresql://user:password@host:5432/postgres

JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=Unnati Loan <noreply@unnatiloan.com.np>

APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
# Extra browser origins allowed to call the API, comma-separated.
# FRONTEND_URL is always allowed on top of this list.
CORS_ORIGINS=

# ── Rate limiting ────────────────────────────────────────────────────────────
# Express `trust proxy` hop count. MUST be 1 when running behind Nginx or any
# reverse proxy, otherwise req.ip is the proxy address for every caller and the
# whole internet shares one rate-limit bucket. Keep 0 when directly exposed, so
# a forged X-Forwarded-For header cannot mint a fresh bucket per request.
TRUST_PROXY=0

# ttl values are milliseconds. All limits are per client IP.
# Ordinary endpoints — one shared budget per client across the whole API.
THROTTLE_GLOBAL_TTL=60000
THROTTLE_GLOBAL_LIMIT=100

# Credential endpoints (login, register, forgot/reset password, verify-email).
# One shared bucket across all of them, so rotating endpoints does not buy an
# attacker a fresh allowance.
THROTTLE_AUTH_TTL=60000
THROTTLE_AUTH_LIMIT=5

# Endpoints with an abusable side effect (sending mail). Keyed per route, so
# each such endpoint gets its own bucket.
THROTTLE_SENSITIVE_TTL=60000
THROTTLE_SENSITIVE_LIMIT=3
