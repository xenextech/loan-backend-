generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  STUDENT
  ADMIN
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
}

enum StudyType {
  PROGRAM
  COURSE
  DIPLOMA
  CERTIFICATION
}

enum IdentityType {
  CITIZENSHIP
  PASSPORT
  DRIVING_LICENSE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum Occupation {
  STUDENT
  EMPLOYED
  SELF_EMPLOYED
  UNEMPLOYED
}

enum FeeStructureMethod {
  DOCUMENT
  LINK
  MANUAL
}

enum DocumentType {
  IDENTITY_FRONT
  IDENTITY_BACK
  APPLICANT_PHOTO
  ACADEMIC_RECORD
  FEE_STRUCTURE
}

enum NotificationType {
  DATABASE
  EMAIL
}

enum AuditAction {
  APPLICATION_CREATED
  APPLICATION_UPDATED
  APPLICATION_SUBMITTED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id                   String    @id @default(uuid())
  email                String    @unique
  passwordHash         String
  role                 UserRole  @default(STUDENT)
  isEmailVerified      Boolean   @default(false)
  emailVerifyToken     String?
  emailVerifyExpiry    DateTime?
  passwordResetToken   String?
  passwordResetExpiry  DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  applications  LoanApplication[]
  notifications Notification[]
  auditLogs     AuditLog[]

  @@map("users")
}

model LoanApplication {
  id                String            @id @default(uuid())
  applicationNumber String            @unique
  status            ApplicationStatus @default(DRAFT)
  userId            String

  // Step 1: Personal Information
  fullName    String?
  email       String?
  phoneNumber String?

  // Step 2: Identity
  identityType   IdentityType?
  identityNumber String?
  identityName   String?
  dateOfBirth    DateTime?
  gender         Gender?
  occupation     Occupation?
  issuedDistrict String?
  issuedDate     DateTime?

  // Step 2: Address
  province     String?
  district     String?
  municipality String?
  ward         String?

  // Step 3: Family
  fatherName      String?
  motherName      String?
  grandfatherName String?
  maritalStatus   MaritalStatus?
  spouseName      String?

  // Step 4: Declaration
  informationAccurate   Boolean?
  authorizeVerification Boolean?
  submittedAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyInformation StudyInformation?
  loanInformation  LoanInformation?
  documents        Document[]
  notifications    Notification[]
  auditLogs        AuditLog[]

  @@index([userId])
  @@index([status])
  @@index([submittedAt])
  @@map("loan_applications")
}

model StudyInformation {
  id            String @id @default(uuid())
  applicationId String @unique

  studyType       StudyType?
  courseName      String?
  boardUniversity String?
  courseDuration  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("study_information")
}

model LoanInformation {
  id            String @id @default(uuid())
  applicationId String @unique

  loanAmount     Decimal? @db.Decimal(12, 2)
  expectedSalary Decimal? @db.Decimal(12, 2)

  feeStructureMethod FeeStructureMethod?
  feeStructureUrl    String?
  feeStructureText   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("loan_information")
}

model Document {
  id            String       @id @default(uuid())
  applicationId String
  documentType  DocumentType

  fileName         String
  originalFileName String
  mimeType         String
  size             Int
  bucketName       String
  filePath         String
  publicUrl        String
  uploadedAt       DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("documents")
}

model Notification {
  id            String           @id @default(uuid())
  userId        String
  applicationId String?

  type    NotificationType
  title   String
  message String
  isRead  Boolean          @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  application LoanApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("notifications")
}

model AuditLog {
  id            String  @id @default(uuid())
  userId        String
  applicationId String?

  action  AuditAction
  payload Json?

  createdAt DateTime @default(now())

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  application LoanApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([applicationId])
  @@map("audit_logs")
}
