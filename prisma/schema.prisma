model Course {
  id        String  @id @default(uuid())
  collegeId String
  college   College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  name           String
  slug           String
  category       CourseCategory
  degreeLevel    DegreeLevel
  // Matches the fixed vocabulary already hardcoded in the frontend apply
  // form's duration dropdown ("6 Months" … "6 Years") so a selected course
  // slots straight into that <Select> with no frontend validation changes.
  duration       String
  durationMonths Int?
  description    String?
  // Long-form "About this course" content — distinct from `description`
  // (the short card/summary blurb). Frontend rendering is deferred; schema
  // only for now, same convention as College.aboutContent.
  aboutContent   String?
  eligibility    String?
  seatsAvailable Int?

  tuitionFee   Decimal  @db.Decimal(12, 2)
  admissionFee Decimal? @db.Decimal(12, 2)
  totalFee     Decimal  @db.Decimal(12, 2)
  // Line-item fee breakdown ([{label, amount}]) — e.g. Semester Fee, Exam
  // Fee, Other Charges — shown on the Course Detail page's Fee Structure
  // section instead of adding a dedicated column per fee type.
  feeBreakdown Json?

  bannerUrl String?
  // Course Detail page content — all optional so a course with none of these
  // set still renders a complete page, just without that section.
  learningOutcomes String[] @default([])
  // [{ title, description?, salaryRange? }]
  careerOutcomes   Json?
  // [{ semester: string, subjects: string[] }]
  curriculum       Json?
  industryDemand   String?
  intake           String?
  credits          Int?
  medium           String?
  attendanceType   String?
  isFeatured       Boolean @default(false)
  isPopular        Boolean @default(false)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

