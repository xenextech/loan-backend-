generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  STUDENT
  ADMIN
  PARENT
  COLLEGE
  INITIATOR
  // Deprecated: use CREDIT_MANAGER. Kept because Postgres enum values can't be
  // cheaply dropped and existing rows/JWTs may still reference it.
  CHECKER
  SUPPORTER
  APPROVER
  CREDIT_MANAGER
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
}

// Who originated the application. STUDENT = self-service, walks the
// Student -> Parent -> College -> Initiator pipeline. INITIATOR = bank staff
// entered it directly (no student/parent/college step required) — it enters
// the same downstream Supporter -> Checker -> Approver -> Credit Manager
// workflow either way. Deliberately its own enum (not folded into
// ApplicationStage) so adding a future source — Agent, Branch, Partner —
// is a one-line enum addition with no change to the approval state machine.
enum ApplicationSource {
  STUDENT
  INITIATOR
}

// Bank approval workflow stage — separate from ApplicationStatus, which only
// tracks the student-facing draft/submitted lifecycle.
enum ApplicationStage {
  INITIATED
  SUPPORTED
  CHECKING
  APPROVED
  REJECTED
  SENT_BACK
}

// Credit ledger status — a LoanAccount is created once an application is
// approved and stays ACTIVE until every EMI schedule entry is paid off.
enum LoanAccountStatus {
  ACTIVE
  CLEARED
  NEEDS_REVIEW
}

// Drives both the interest compounding period and the installment period —
// a mismatched compounding/payment frequency isn't a requirement anywhere in
// this system, so one field governs both rather than two independent ones.
enum RepaymentFrequency {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum CollectionActivityType {
  CALL
  SMS
  EMAIL
  WHATSAPP
  VISIT
  NOTE
  OTHER
}

enum StudyType {
  PROGRAM
  COURSE
  DIPLOMA
  CERTIFICATION
}

enum IdentityType {
  CITIZENSHIP
  PASSPORT
  DRIVING_LICENSE
  NATIONAL_ID
  PAN_NUMBER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum Occupation {
  STUDENT
  EMPLOYED
  SELF_EMPLOYED
  UNEMPLOYED
}

enum FeeStructureMethod {
  DOCUMENT
  LINK
  MANUAL
}

enum DocumentType {
  IDENTITY_FRONT
  IDENTITY_BACK
  IDENTITY_DOCUMENT
  APPLICANT_PHOTO
  ACADEMIC_RECORD
  FEE_STRUCTURE
  STUDENT_APPLICATION
  OFFER_LETTER
  ENROLLMENT_DOCUMENT
}

enum NotificationType {
  DATABASE
  EMAIL
}

enum AuditAction {
  APPLICATION_CREATED
  APPLICATION_UPDATED
  APPLICATION_SUBMITTED
  APPLICATION_LINK_GENERATED
  APPLICATION_SUPPORTED
  APPLICATION_CHECKED
  APPLICATION_APPROVED
  APPLICATION_REJECTED
  APPLICATION_SENT_BACK
  APPLICATION_RESUBMITTED
  LOAN_ACCOUNT_CREATED
  LOAN_CLEARED
  LOAN_SERVICING_CONFIGURED
  LOAN_SERVICING_NOTIFIED
  COLLECTION_ACTIVITY_RECORDED
  LOAN_NEEDS_REVIEW
  LOAN_REVIEW_RESOLVED
  PEP_SCREENING_RECORDED
  COLLEGE_FORM_SUBMITTED
  PARENT_FORM_SUBMITTED
  DISBURSEMENT_CONDITION_UPDATED
  DISBURSEMENT_CONFIRMED
  DISBURSEMENT_TRANCHE_CREATED
  EMI_SCHEDULE_GENERATED
  EMI_PAYMENT_RECORDED
  EMI_MARKED_OVERDUE
  PENAL_INTEREST_ACCRUED
  LOAN_RECLASSIFIED
  COMMISSION_ENTRY_CREATED
  COMMISSION_ENTRY_PAID
  COMMISSION_PARTNER_UPDATED
  AGREEMENT_GENERATED
  AGREEMENT_SIGNED
  AGREEMENT_FORWARDED
  INSURANCE_POLICY_ADDED
  NOTIFICATION_TEMPLATE_UPDATED
  OFFER_LETTER_VERIFIED
  MANUAL_AUDIT_ENTRY
  APPROVER_TERMS_ACCEPTED
  STUDENT_CONSENT_SENT
  STUDENT_CONSENT_ACCEPTED
  BANK_ACCOUNT_OPENING_REQUIRED
  BANK_ACCOUNT_OPENING_COMPLETED
  MARKETPLACE_COLLEGE_CREATED
  MARKETPLACE_COLLEGE_UPDATED
  MARKETPLACE_COLLEGE_DELETED
  MARKETPLACE_COURSE_CREATED
  MARKETPLACE_COURSE_UPDATED
  MARKETPLACE_COURSE_DELETED
  MARKETPLACE_UNIVERSITY_CREATED
  MARKETPLACE_UNIVERSITY_UPDATED
  MARKETPLACE_UNIVERSITY_DELETED
  VERIFICATION_INVITATION_CREATED
  VERIFICATION_INVITATION_RESENT
  VERIFICATION_INVITATION_REVOKED
  VERIFICATION_LINK_ACCESSED
  VERIFICATION_FAILED
}

enum AuditCategory {
  APPROVAL
  DISBURSEMENT
  REPAYMENT
  COMMISSION
  SYSTEM
}

enum ApplicationLinkType {
  PARENT
  COLLEGE
  STUDENT_CONSENT
}

// Lifecycle of a PARENT/COLLEGE verification invitation (ApplicationLink).
// EXPIRED is not stored — it's derived by comparing expiresAt to now, so it's
// always accurate without a background job to flip a stale status.
enum VerificationStatus {
  SENT
  FAILED
  OPENED
  VERIFIED
  REVOKED
}

enum NotificationChannel {
  APP
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationDeliveryStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

enum DisbursementConditionStatus {
  PENDING
  DONE
  MISSING
}

enum DisbursementStatus {
  PENDING
  PARTIAL
  COMPLETED
}

enum TrancheStatus {
  PENDING
  CREDITED
  FAILED
}

enum EmiStatus {
  UPCOMING
  PAID
  OVERDUE
  PARTIAL
}

// NRB-aligned loan classification, driven by the oldest unpaid installment's
// days-overdue: PASS (<90d) -> SUBSTANDARD (90-179d) -> DOUBTFUL (180-364d) -> LOSS (365d+).
// Recomputed daily by the same cron that marks entries overdue.
enum NrbLoanClassification {
  PASS
  SUBSTANDARD
  DOUBTFUL
  LOSS
}

enum GeneratedAgreementType {
  LOAN_AGREEMENT
  GUARANTEE_DEED
  HYPOTHECATION
  PROMISSORY_NOTE
}

enum GeneratedAgreementStatus {
  DRAFT
  PENDING_SIGNATURE
  SIGNED
  ACTIVE
}

enum CommissionPartnerType {
  BANK
  COLLEGE
}

enum CommissionRateType {
  FLAT
  PERCENTAGE
}

enum CommissionEntryStatus {
  PENDING
  INVOICE_DUE
  PAID
}

enum DegreeLevel {
  CERTIFICATE
  DIPLOMA
  BACHELOR
  MASTER
  PHD
}

enum CourseCategory {
  ENGINEERING
  MANAGEMENT
  IT_COMPUTER_SCIENCE
  MEDICINE_HEALTH_SCIENCE
  SCIENCE
  HUMANITIES_SOCIAL_SCIENCE
  LAW
  EDUCATION
  HOSPITALITY_TOURISM
  AGRICULTURE
  OTHER
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id        String  @id @default(uuid())
  email     String  @unique
  firstName String?
  lastName  String?
  // Denormalized "firstName lastName" convenience field, kept in sync at
  // registration — still the one read everywhere else in the app (approval
  // records, notifications, dashboard displays), so those call sites don't
  // need to change now that the name is captured in two parts.
  fullName            String?
  passwordHash        String
  role                UserRole   @default(STUDENT)
  isEmailVerified     Boolean    @default(false)
  emailVerifyToken    String?
  emailVerifyExpiry   DateTime?
  passwordResetToken  String?
  passwordResetExpiry DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  applications  LoanApplication[]
  notifications Notification[]
  auditLogs     AuditLog[]
  parentProfile ParentProfile?

  @@map("users")
}

model LoanApplication {
  id                String            @id @default(uuid())
  applicationNumber String?           @unique
  status            ApplicationStatus @default(DRAFT)
  stage             ApplicationStage?
  source            ApplicationSource @default(STUDENT)
  userId            String?
  branch            String?

  // Step 1: Personal Information
  fullName    String?
  email       String?
  phoneNumber String?
  collegeName String?
  // Optional link to a College Marketplace catalog entry — collegeName above
  // stays the source of truth for everything downstream (verification, offer
  // letters, PDFs); this FK is only for marketplace-originated applications.
  // SetNull (not Cascade) so removing a catalog college never touches a
  // submitted application's frozen record.
  collegeId   String?
  college     College? @relation(fields: [collegeId], references: [id], onDelete: SetNull)

  // Step 2: Identity
  identityType   IdentityType?
  identityNumber String?
  identityName   String?
  // Canonical AD date of birth — used for storage, age calculation, and as the
  // source of truth. dobBs (Bikram Sambat) is kept in sync automatically from
  // this value; see BsAdDate utils in common/utils/bs-ad-date.util.ts.
  dateOfBirth    DateTime?
  dobBs          String?
  gender         Gender?
  occupation     Occupation?
  issuedDistrict String?
  issuedDate     DateTime?

  // Step 2: Address
  province     String?
  district     String?
  municipality String?
  ward         String?

  // Step 3: Family
  fatherName      String?
  motherName      String?
  grandfatherName String?
  maritalStatus   MaritalStatus?
  spouseName      String?

  // Step 4: Declaration
  informationAccurate   Boolean?
  authorizeVerification Boolean?
  submittedAt           DateTime?

  // Basic Information (Credit Appraisal)
  customerName                String?
  relationshipStartDate       DateTime?
  customerGroup               String?
  obligorNumber               Int?
  permanentAddress            String?
  correspondenceAddress       String?
  profession                  String?
  repaymentSource             String?
  citizenshipNumber           String?
  citizenshipIssuedDate       DateTime?
  citizenshipIssuedPlace      String?
  nidNumber                   String?
  panNumber                   String?
  licenseNumber               String?
  existingBankingRelationship String?
  isBlacklisted               Boolean?

  // Detailed blacklist section — conditionally required based on
  // blacklistStatus; see ApplicationInitiatorService's blacklist validation.
  // isBlacklisted above is a separate legacy flag, left untouched.
  blacklistStatus          BlacklistStatus?
  blacklistReason          String?
  blacklistDate            DateTime?
  blacklistReferenceNumber String?

  // PEP (Politically Exposed Person) screening — recorded via a dedicated
  // check step, not just a manually-set flag like isBlacklisted above.
  pepStatus          Boolean?
  pepRemarks         String?
  pepCheckedAt       DateTime?
  pepCheckedByUserId String?

  // Step 5: Family Structure / Credit Facility
  facility     String?
  purpose      String?
  limit        Decimal?    @db.Decimal(18, 2)
  period       Int?
  periodUnit   PeriodUnit?
  interestRate Decimal?    @db.Decimal(5, 2)
  fee          Decimal?    @db.Decimal(18, 2)
  remarks      String?

  // Step 6: NRB Reporting
  baselClassification String?
  baselRiskWeight     Int?

  nrb93SectorCode       String?
  nrb93KaProductCode    String?
  nrb94SecurityTypeCode String?

  sis0IndustrialClassification        String?
  sis1ProductType                     String?
  sis2Sector                          String?
  sis3Security                        String?
  sis4InstitutionalGroupingOfBorrower String?
  sis9PriorityLending                 String?

  greenFinanceEconomicSector String?
  greenFinanceSubSector      String?
  greenFinanceTaxonomyTag    String?

  // Step 8: Credit Appraisal
  moneyLaunderingRisk         String?
  amlRisk                     String?
  waiver                      String?
  termsAndConditions          String?
  bankingRelationship         String?
  // Collected only when bankingRelationship is "EXISTING" — details of the
  // applicant's existing account at the bank (see Step1ApplicantInfo.tsx).
  existingBankName            String?
  existingBankAccountNumber   String?
  existingBankSavingsAmount   Decimal? @db.Decimal(18, 2)
  existingBankLoanAmount      Decimal? @db.Decimal(18, 2)
  bankingRelationshipRemarks  String?
  keyCreditRiskMitigation     String?
  justificationOfLoan         String?
  accountStrategy             String?
  disbursementSection         String?
  utilizationOfFund           String?
  conclusionAndRecommendation String?

  // Approval Section — *UserId columns identify who acted (set from the
  // authenticated user, never client input); *Name is that user's fullName
  // denormalized at approval time. CREDIT_MANAGER is the same role/stage as
  // CHECKER in this system (see dashboard/README.md), so it reuses these
  // checker* fields rather than duplicating storage — see
  // DashboardApprovalService.getSummary().
  // *Remarks/*Status back the Step 9 in-form approval chain (see
  // ApprovalEntryStatus above) — added alongside the pre-existing
  // Name/Post/Date/Signature columns rather than duplicating them.
  initiatorUserId    String?
  initiatorName      String?
  initiatorPost      String?
  initiatorDate      DateTime?
  initiatorSignature String?
  initiatorRemarks   String?
  initiatorStatus    ApprovalEntryStatus?

  supporterUserId    String?
  supporterName      String?
  supporterPost      String?
  // Branch the Supporter recorded for their own decision — distinct from the
  // single application-wide `branch` field below, which is the Initiator's.
  // Same pattern for checkerBranch/approverBranch. Written by the real
  // support/check/approve/reject/send-back actions (DashboardApprovalService),
  // not just the Initiator wizard's Step 9 like *Post originally was.
  supporterBranch    String?
  supporterDate      DateTime?
  supporterSignature String?
  supporterRemarks   String?
  supporterStatus    ApprovalEntryStatus?

  checkerUserId    String?
  checkerName      String?
  checkerPost      String?
  checkerBranch    String?
  checkerDate      DateTime?
  checkerSignature String?
  checkerRemarks   String?
  checkerStatus    ApprovalEntryStatus?

  approverUserId    String?
  approverName      String?
  approverPost      String?
  approverBranch    String?
  approverDate      DateTime?
  approverSignature String?
  approverRemarks   String?
  approverStatus    ApprovalEntryStatus?

  // Rejection tracking
  rejectionReason  String?
  rejectedAt       DateTime?
  rejectedByUserId String?

  // Send-back tracking — toStage is the stage it's being rewound to
  sentBackReason   String?
  sentBackAt       DateTime?
  sentBackByUserId String?
  sentBackToStage  ApplicationStage?
  // True only when the Approver themself sent it back (Supporter/Checker/
  // Credit Manager send-backs never set this). While true, the next
  // support()/check() call routes the application straight to CHECKING
  // (Approver-actionable) instead of its normal next stage, skipping
  // whichever intermediate role(s) sit between the chosen target and the
  // Approver — consumed (reset to false) the moment that happens.
  sentBackByApprover Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user             User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyInformation StudyInformation?
  loanInformation  LoanInformation?

  documents           Document[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  applicationLinks    ApplicationLink[]
  collegeVerification CollegeVerification?
  parentVerification  ParentVerification?
  studentConsent      StudentConsent?
  bankAccountOpening  BankAccountOpening?

  // College-generated document templates, optionally linked from their side
  // (applicationId is nullable there) — see OfferLetter/Agreement/EnrollmentCertificate.
  offerLetters           OfferLetter[]
  agreements             Agreement[]
  enrollmentCertificates EnrollmentCertificate[]
  // security
  securityDetails     String?

  fmv          Decimal? @db.Decimal(18, 2)
  proposedLoan Decimal? @db.Decimal(18, 2)

  financeAgainstFmv         Decimal?                @db.Decimal(5, 2)
  personalGuarantee         PersonalGuarantee?
  insurance                 Insurance?
  repaymentCapacity         RepaymentCapacity?
  familyMember              FamilyMember[]
  existingFacility          ExistingFacility[]
  disbursementConditions    DisbursementCondition[]
  disbursement              Disbursement?
  loanAccount               LoanAccount?
  emiSchedule               EmiScheduleEntry[]
  collectionActivities      CollectionActivity[]
  generatedAgreements       GeneratedAgreement[]
  insurancePolicies         InsurancePolicy[]
  commissionEntries         CommissionEntry[]
  creditLimit               Decimal?                @db.Decimal(18, 2)
  income                    Decimal?                @db.Decimal(18, 2)
  dsgir                     Int?
  operationOfInstitution    Int?
  satisfactoryPerformance   Int?
  parentsBorrowingsWithBFIs String?
  sourceOfIncome            String?
  loanToValueRatio          Decimal?                @db.Decimal(5, 2)
  performanceYears          Int?
  bankingRelationshipScore  Int?
  sourceOfIncomeScore       Int?
  creditRiskScoring         String?
  riskGrade                 String?
  totalScore                Int?
  totalPercentage           Decimal?                @db.Decimal(5, 2)

  // NRB loan classification — recomputed daily from the oldest unpaid EMI
  // installment's days-overdue (see NrbLoanClassification). Display label only;
  // does not gate any other behavior.
  nrbClassification         NrbLoanClassification   @default(PASS)
  nrbClassifiedAt           DateTime?

  @@index([userId])
  @@index([status])
  @@index([stage])
  @@index([source])
  @@index([submittedAt])
  @@index([collegeId])
  @@map("loan_applications")
}

model StudyInformation {
  id            String @id @default(uuid())
  applicationId String @unique

  studyType       StudyType?
  courseName      String?
  boardUniversity String?
  courseDuration  String?

  // Optional link to a College Marketplace course — courseName/boardUniversity/
  // courseDuration above stay the source of truth for display; this FK is only
  // for marketplace-originated applications. tuitionFee is a fee snapshot taken
  // at application time (course pricing may change later without affecting it).
  courseId   String?
  course     Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  tuitionFee Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@map("study_information")
}

model LoanInformation {
  id            String @id @default(uuid())
  applicationId String @unique

  loanAmount     Decimal? @db.Decimal(12, 2)
  expectedSalary Decimal? @db.Decimal(12, 2)

  feeStructureMethod FeeStructureMethod?
  feeStructureUrl    String?
  feeStructureText   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("loan_information")
}

model Document {
  id            String       @id @default(uuid())
  applicationId String
  documentType  DocumentType

  fileName         String
  originalFileName String
  mimeType         String
  size             Int
  bucketName       String
  filePath         String
  publicUrl        String
  uploadedAt       DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("documents")
}

model FamilyMember {
  id String @id @default(cuid())

  applicationId String
  application   LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  personName                  String?
  age                         Int?
  qualification               String?
  relationshipWithBorrower    String?
  occupationSocialInvolvement String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicationId])
}

// Other credit facilities the applicant/household currently holds at other
// banks/BFIs (Step 4 of the Loan Assessment wizard) — distinct from
// `facility`/`limit`/etc. on LoanApplication itself, which describe the one
// facility being proposed under *this* application.
model ExistingFacility {
  id String @id @default(cuid())

  applicationId String
  application   LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  facilityType    String?
  bank            String?
  sanctionedLimit Decimal?        @db.Decimal(18, 2)
  outstanding     Decimal?        @db.Decimal(18, 2)
  status          FacilityStatus?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicationId])
}

enum FacilityStatus {
  PERFORMING
  OVERDUE
  NPA
  CLOSED
}

enum FamilyStructure {
  NUCLEAR
  JOINT
  EXTENDED
  SINGLE_PARENT
  OTHER
}

enum PeriodUnit {
  YEAR
  MONTH
}

enum BlacklistStatus {
  BLACKLISTED
  NOT_BLACKLISTED
}

// Per-role status within the Initiator wizard's in-form approval chain
// (Step 9) — distinct from the bank-wide ApplicationStage, which tracks the
// application's overall position in the Supporter -> Checker -> Approver
// pipeline. This tracks each individual role's own sign-off state on that
// chain (e.g. Support has intermediate UNDER_REVIEW/FIELD_VERIFIED steps
// before its final call).
enum ApprovalEntryStatus {
  PENDING
  WAITING
  UNDER_REVIEW
  FIELD_VERIFIED
  APPROVED
  REJECTED
  SENT_BACK
}

model PersonalGuarantee {
  id String @id @default(cuid())

  applicationId String          @unique
  application   LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  nameOfGuarantor String?
  relationship    String?

  age Int?

  netWorth Decimal? @db.Decimal(18, 2)

  guarantorConsent Boolean?

  ciclStatus  Boolean?
  ciclRemarks String?

  blackListedDate DateTime?
  releasedDate    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Insurance {
  id String @id @default(cuid())

  applicationId String          @unique
  application   LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  insuredName          String?
  insuranceCompanyName String?
  sumInsured           Decimal? @db.Decimal(18, 2)
  maturityDate         DateTime?
  policyNo             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RepaymentCapacity {
  id String @id @default(cuid())

  applicationId String          @unique
  application   LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  insuredAssets Int?

  valueOfAssets  Decimal? @db.Decimal(18, 2)
  sumOfInsurance Decimal? @db.Decimal(18, 2)

  insuranceCoverage Decimal? @db.Decimal(5, 2)
  insuranceRemarks  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id            String  @id @default(uuid())
  userId        String
  applicationId String?

  type           NotificationType
  channel        NotificationChannel?
  deliveryStatus NotificationDeliveryStatus?
  title          String
  message        String
  isRead         Boolean                     @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  application LoanApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("notifications")
}

model ParentProfile {
  id     String @id @default(uuid())
  userId String @unique

  name              String?
  phone             String?
  contact           String?
  citizenshipNumber String?
  salaryBankName    String?
  bankAccountNumber String?

  // Salary sheet document fields
  salarySheetFileName         String?
  salarySheetOriginalFileName String?
  salarySheetMimeType         String?
  salarySheetSize             Int?
  salarySheetBucketName       String?
  salarySheetFilePath         String?
  salarySheetPublicUrl        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("parent_profiles")
}

model AuditLog {
  id            String  @id @default(uuid())
  userId        String
  applicationId String?

  action   AuditAction
  category AuditCategory @default(SYSTEM)
  payload  Json?

  createdAt DateTime @default(now())

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  application LoanApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([applicationId])
  @@index([category])
  @@map("audit_logs")
}

model ApplicationLink {
  id             String              @id @default(uuid())
  // Raw token, kept ONLY while the invitation is still SENT/OPENED so the
  // authenticated college "My Verifications" dashboard can re-link to it
  // (CollegeService.getMyVerifications). It is never used to authenticate a
  // request — resolution always hashes the incoming URL token and looks up
  // tokenHash. Nulled out once the invitation is VERIFIED or REVOKED, so a
  // database leak can no longer yield a working link for anything already
  // resolved (most of an application's lifetime).
  token            String?             @unique
  // Nullable so the 81 pre-existing rows in this table (created before this
  // field existed) don't need a backfill — every row created by the new
  // invitation flow always sets both. Resolution falls back to the legacy
  // raw-token lookup when tokenHash is absent, so old links keep working.
  tokenHash        String?             @unique
  verificationCode String?             @unique
  applicationId    String
  linkType         ApplicationLinkType
  recipientEmail   String?
  status           VerificationStatus  @default(SENT)
  expiresAt        DateTime
  accessedAt       DateTime?
  verifiedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime            @default(now())

  application LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([recipientEmail])
