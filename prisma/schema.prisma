generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  STUDENT
  ADMIN
  PARENT
  COLLEGE
  INITIATOR
  // Deprecated: use CREDIT_MANAGER. Kept because Postgres enum values can't be
  // cheaply dropped and existing rows/JWTs may still reference it.
  CHECKER
  SUPPORTER
  APPROVER
  CREDIT_MANAGER
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
}

// Bank approval workflow stage — separate from ApplicationStatus, which only
// tracks the student-facing draft/submitted lifecycle.
enum ApplicationStage {
  INITIATED
  SUPPORTED
  CHECKING
  APPROVED
  REJECTED
  SENT_BACK
}

// Credit ledger status — a LoanAccount is created once an application is
// approved and stays ACTIVE until every EMI schedule entry is paid off.
enum LoanAccountStatus {
  ACTIVE
  CLEARED
  NEEDS_REVIEW
}

// Drives both the interest compounding period and the installment period —
// a mismatched compounding/payment frequency isn't a requirement anywhere in
// this system, so one field governs both rather than two independent ones.
enum RepaymentFrequency {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum CollectionActivityType {
  CALL
  SMS
  EMAIL
  WHATSAPP
  VISIT
  NOTE
  OTHER
}

enum StudyType {
  PROGRAM
  COURSE
  DIPLOMA
  CERTIFICATION
}

enum IdentityType {
  CITIZENSHIP
  PASSPORT
  DRIVING_LICENSE
  NATIONAL_ID
  PAN_NUMBER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum Occupation {
  STUDENT
  EMPLOYED
  SELF_EMPLOYED
  UNEMPLOYED
}

enum FeeStructureMethod {
  DOCUMENT
  LINK
  MANUAL
}

enum DocumentType {
  IDENTITY_FRONT
  IDENTITY_BACK
  IDENTITY_DOCUMENT
  APPLICANT_PHOTO
  ACADEMIC_RECORD
  FEE_STRUCTURE
  STUDENT_APPLICATION
  OFFER_LETTER
  ENROLLMENT_DOCUMENT
}

enum NotificationType {
  DATABASE
  EMAIL
}

enum AuditAction {
  APPLICATION_CREATED
  APPLICATION_UPDATED
  APPLICATION_SUBMITTED
  APPLICATION_LINK_GENERATED
  APPLICATION_SUPPORTED
  APPLICATION_CHECKED
  APPLICATION_APPROVED
  APPLICATION_REJECTED
  APPLICATION_SENT_BACK
  LOAN_ACCOUNT_CREATED
  LOAN_CLEARED
  LOAN_SERVICING_CONFIGURED
  LOAN_SERVICING_NOTIFIED
  COLLECTION_ACTIVITY_RECORDED
  LOAN_NEEDS_REVIEW
  LOAN_REVIEW_RESOLVED
  PEP_SCREENING_RECORDED
  COLLEGE_FORM_SUBMITTED
  PARENT_FORM_SUBMITTED
  DISBURSEMENT_CONDITION_UPDATED
  DISBURSEMENT_CONFIRMED
  DISBURSEMENT_TRANCHE_CREATED
  EMI_SCHEDULE_GENERATED
  EMI_PAYMENT_RECORDED
  EMI_MARKED_OVERDUE
  PENAL_INTEREST_ACCRUED
  LOAN_RECLASSIFIED
  COMMISSION_ENTRY_CREATED
  COMMISSION_ENTRY_PAID
  COMMISSION_PARTNER_UPDATED
  AGREEMENT_GENERATED
  AGREEMENT_SIGNED
  INSURANCE_POLICY_ADDED
  NOTIFICATION_TEMPLATE_UPDATED
  OFFER_LETTER_VERIFIED
  MANUAL_AUDIT_ENTRY
}

enum AuditCategory {
  APPROVAL
  DISBURSEMENT
  REPAYMENT
  COMMISSION
  SYSTEM
}

enum ApplicationLinkType {
  PARENT
  COLLEGE
}

enum NotificationChannel {
  APP
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationDeliveryStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

enum DisbursementConditionStatus {
  PENDING
  DONE
  MISSING
}

enum DisbursementStatus {
  PENDING
  PARTIAL
  COMPLETED
}

enum TrancheStatus {
  PENDING
  CREDITED
  FAILED
}

enum EmiStatus {
  UPCOMING
  PAID
  OVERDUE
  PARTIAL
}

// NRB-aligned loan classification, driven by the oldest unpaid installment's
// days-overdue: PASS (<90d) -> SUBSTANDARD (90-179d) -> DOUBTFUL (180-364d) -> LOSS (365d+).
// Recomputed daily by the same cron that marks entries overdue.
enum NrbLoanClassification {
  PASS
  SUBSTANDARD
  DOUBTFUL
  LOSS
}

enum GeneratedAgreementType {
  LOAN_AGREEMENT
  GUARANTEE_DEED
  HYPOTHECATION
  PROMISSORY_NOTE
}

enum GeneratedAgreementStatus {
  DRAFT
  PENDING_SIGNATURE
  SIGNED
  ACTIVE
}

enum CommissionPartnerType {
  BANK
  COLLEGE
}

enum CommissionRateType {
  FLAT
  PERCENTAGE
}

enum CommissionEntryStatus {
  PENDING
  INVOICE_DUE
  PAID
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  passwordHash        String
  role                UserRole  @default(STUDENT)
  isEmailVerified     Boolean   @default(false)
  emailVerifyToken    String?
  emailVerifyExpiry   DateTime?
  passwordResetToken  String?
  passwordResetExpiry DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  applications  LoanApplication[]
  notifications Notification[]
  auditLogs     AuditLog[]
  parentProfile ParentProfile?

  @@map("users")
}

model LoanApplication {
  id                String            @id @default(uuid())
  applicationNumber String?           @unique
  status            ApplicationStatus @default(DRAFT)
  stage             ApplicationStage?
  userId            String?
  branch            String?

  // Step 1: Personal Information
  fullName    String?
  email       String?
  phoneNumber String?

  // Step 2: Identity
  identityType   IdentityType?
  identityNumber String?
  identityName   String?
  // Canonical AD date of birth — used for storage, age calculation, and as the
  // source of truth. dobBs (Bikram Sambat) is kept in sync automatically from
  // this value; see BsAdDate utils in common/utils/bs-ad-date.util.ts.
  dateOfBirth    DateTime?
  dobBs          String?
  gender         Gender?
  occupation     Occupation?
  issuedDistrict String?
  issuedDate     DateTime?

  // Step 2: Address
  province     String?
  district     String?
  municipality String?
  ward         String?

  // Step 3: Family
  fatherName      String?
  motherName      String?
  grandfatherName String?
  maritalStatus   MaritalStatus?
  spouseName      String?

  // Step 4: Declaration
  informationAccurate   Boolean?
  authorizeVerification Boolean?
  submittedAt           DateTime?

  // Basic Information (Credit Appraisal)
  customerName                String?
  relationshipStartDate       DateTime?
  customerGroup               String?
  obligorNumber               Int?
  permanentAddress            String?
  correspondenceAddress       String?
  profession                  String?
  repaymentSource             String?
  citizenshipNumber           String?
  citizenshipIssuedDate       DateTime?
  citizenshipIssuedPlace      String?
  nidNumber                   String?
  panNumber                   String?
  licenseNumber               String?
  existingBankingRelationship String?
  isBlacklisted               Boolean?

  // Detailed blacklist section — conditionally required based on
  // blacklistStatus; see ApplicationInitiatorService's blacklist validation.
  // isBlacklisted above is a separate legacy flag, left untouched.
  blacklistStatus          BlacklistStatus?
  blacklistReason          String?
  blacklistDate            DateTime?
  blacklistReferenceNumber String?

  // PEP (Politically Exposed Person) screening — recorded via a dedicated
  // check step, not just a manually-set flag like isBlacklisted above.
  pepStatus          Boolean?
  pepRemarks         String?
  pepCheckedAt       DateTime?
  pepCheckedByUserId String?

  // Step 5: Family Structure / Credit Facility
  facility     String?
  purpose      String?
  limit        Decimal?    @db.Decimal(18, 2)
  period       Int?
  periodUnit   PeriodUnit?
  interestRate Decimal?    @db.Decimal(5, 2)
  fee          Decimal?    @db.Decimal(18, 2)
  remarks      String?

  // Step 6: NRB Reporting
  baselClassification String?
  baselRiskWeight     Int?

  nrb93SectorCode       String?
  nrb93KaProductCode    String?
  nrb94SecurityTypeCode String?

  sis0IndustrialClassification        String?
  sis1ProductType                     String?
  sis2Sector                          String?
  sis3Security                        String?
  sis4InstitutionalGroupingOfBorrower String?
  sis9PriorityLending                 String?

  greenFinanceEconomicSector String?
  greenFinanceSubSector      String?
  greenFinanceTaxonomyTag    String?

  // Step 8: Credit Appraisal
  moneyLaunderingRisk         String?
  amlRisk                     String?
  waiver                      String?
  termsAndConditions          String?
  bankingRelationship         String?
  bankingRelationshipRemarks  String?
  keyCreditRiskMitigation     String?
  justificationOfLoan         String?
  accountStrategy             String?
  disbursementSection         String?
  utilizationOfFund           String?
  conclusionAndRecommendation String?

  // Approval Section
  initiatorName      String?
  initiatorPost      String?
  initiatorDate      DateTime?
  initiatorSignature String?

  supporterName      String?
  supporterPost      String?
  supporterDate      DateTime?
  supporterSignature String?

  checkerName      String?
  checkerPost      String?
  checkerDate      DateTime?
  checkerSignature String?

  approverName      String?
  approverPost      String?
  approverDate      DateTime?
  approverSignature String?

  // Rejection tracking
  rejectionReason  String?
  rejectedAt       DateTime?
  rejectedByUserId String?

  // Send-back tracking — toStage is the stage it's being rewound to
  sentBackReason   String?
  sentBackAt       DateTime?
  sentBackByUserId String?
  sentBackToStage  ApplicationStage?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user             User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyInformation StudyInformation?
  loanInformation  LoanInformation?

  documents           Document[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  applicationLinks    ApplicationLink[]
  collegeVerification CollegeVerification?
  parentVerification  ParentVerification?
  // security
  securityDetails     String?

  fmv          Decimal? @db.Decimal(18, 2)
  proposedLoan Decimal? @db.Decimal(18, 2)

  financeAgainstFmv         Decimal?                @db.Decimal(5, 2)
  personalGuarantee         PersonalGuarantee?
  insurance                 Insurance?
  repaymentCapacity         RepaymentCapacity?
  familyMember              FamilyMember[]
  disbursementConditions    DisbursementCondition[]
  disbursement              Disbursement?
  loanAccount               LoanAccount?
  emiSchedule               EmiScheduleEntry[]
  collectionActivities      CollectionActivity[]
  generatedAgreements       GeneratedAgreement[]
  insurancePolicies         InsurancePolicy[]
  commissionEntries         CommissionEntry[]
  creditLimit               Decimal?                @db.Decimal(18, 2)
  dsgir                     Int?
  operationOfInstitution    Int?
  satisfactoryPerformance   Int?
  parentsBorrowingsWithBFIs String?
  sourceOfIncome            String?
  loanToValueRatio          Decimal?                @db.Decimal(5, 2)
  performanceYears          Int?
  bankingRelationshipScore  Int?
  sourceOfIncomeScore       Int?
  creditRiskScoring         String?
  riskGrade                 String?
  totalScore                Int?
  totalPercentage           Decimal?                @db.Decimal(5, 2)

  // NRB loan classification — recomputed daily from the oldest unpaid EMI
  // installment's days-overdue (see NrbLoanClassification). Display label only;
  // does not gate any other behavior.
  nrbClassification         NrbLoanClassification   @default(PASS)
  nrbClassifiedAt           DateTime?

  @@index([userId])
  @@index([status])
  @@index([stage])
  @@index([submittedAt])
  @@map("loan_applications")
}

model StudyInformation {
  id            String @id @default(uuid())
  applicationId String @unique

  studyType       StudyType?
  courseName      String?
  boardUniversity String?
  courseDuration  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("study_information")
}

model LoanInformation {
  id            String @id @default(uuid())
  applicationId String @unique

  loanAmount     Decimal? @db.Decimal(12, 2)
  expectedSalary Decimal? @db.Decimal(12, 2)

  feeStructureMethod FeeStructureMethod?
  feeStructureUrl    String?
  feeStructureText   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("loan_information")
}

model Document {
  id            String       @id @default(uuid())
  applicationId String
  documentType  DocumentType

  fileName         String
  originalFileName String
  mimeType         String
  size             Int
  bucketName       String
  filePath         String
  publicUrl        String
  uploadedAt       DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("documents")
}

model FamilyMember {
  id String @id @default(cuid())

  applicationId String
  application   LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  personName                  String?
  age                         Int?
  qualification               String?
  relationshipWithBorrower    String?
  occupationSocialInvolvement String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicationId])
}

enum FamilyStructure {
  NUCLEAR
  JOINT
  EXTENDED
  SINGLE_PARENT
  OTHER
}

enum PeriodUnit {
  YEAR
  MONTH
}

enum BlacklistStatus {
  BLACKLISTED
  NOT_BLACKLISTED
}

model PersonalGuarantee {
  id String @id @default(cuid())

  applicationId String          @unique
  application   LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  nameOfGuarantor String?
  relationship    String?

  age Int?

  netWorth Decimal? @db.Decimal(18, 2)

  guarantorConsent Boolean?

  ciclStatus  Boolean?
  ciclRemarks String?

  blackListedDate DateTime?
  releasedDate    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Insurance {
  id String @id @default(cuid())

  applicationId String          @unique
  application   LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  insuredAssets String?

  valueOfAssets  Decimal? @db.Decimal(18, 2)
  sumOfInsurance Decimal? @db.Decimal(18, 2)

  insuranceCoverage Decimal? @db.Decimal(5, 2)
  insuranceRemarks  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RepaymentCapacity {
  id String @id @default(cuid())

  applicationId String          @unique
  application   LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  insuredAssets Int?

  valueOfAssets  Decimal? @db.Decimal(18, 2)
  sumOfInsurance Decimal? @db.Decimal(18, 2)

  insuranceCoverage Decimal? @db.Decimal(5, 2)
  insuranceRemarks  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id            String  @id @default(uuid())
  userId        String
  applicationId String?

  type           NotificationType
  channel        NotificationChannel?
  deliveryStatus NotificationDeliveryStatus?
  title          String
  message        String
  isRead         Boolean                     @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  application LoanApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("notifications")
}

model ParentProfile {
  id     String @id @default(uuid())
  userId String @unique

  name              String?
  phone             String?
  contact           String?
  citizenshipNumber String?
  salaryBankName    String?
  bankAccountNumber String?

  // Salary sheet document fields
  salarySheetFileName         String?
  salarySheetOriginalFileName String?
  salarySheetMimeType         String?
  salarySheetSize             Int?
  salarySheetBucketName       String?
  salarySheetFilePath         String?
  salarySheetPublicUrl        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("parent_profiles")
}

model AuditLog {
  id            String  @id @default(uuid())
  userId        String
  applicationId String?

  action   AuditAction
  category AuditCategory @default(SYSTEM)
  payload  Json?

  createdAt DateTime @default(now())

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  application LoanApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([applicationId])
  @@index([category])
  @@map("audit_logs")
}

model ApplicationLink {
  id             String              @id @default(uuid())
  token          String              @unique
  applicationId  String
  linkType       ApplicationLinkType
  recipientEmail String?
  expiresAt      DateTime
  accessedAt     DateTime?
  createdAt      DateTime            @default(now())

  application LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([recipientEmail])
  @@index([applicationId])
  @@map("application_links")
}

model CollegeVerification {
  id            String @id @default(uuid())
  applicationId String @unique

  collegeName   String?
  collegeEmail  String?
  contactPerson String?
  contactPhone  String?

  isApplicationVerified Boolean @default(false)
  verificationNotes     String?

  offerLetterVerified         Boolean   @default(false)
  offerLetterVerifiedAt       DateTime?
  offerLetterVerifiedByUserId String?

  // Offer letter document
  offerLetterFileName         String?
  offerLetterOriginalFileName String?
  offerLetterMimeType         String?
  offerLetterSize             Int?
  offerLetterBucketName       String?
  offerLetterFilePath         String?
  offerLetterPublicUrl        String?

  // Enrollment docs
  enrollmentDocFileName         String?
  enrollmentDocOriginalFileName String?
  enrollmentDocMimeType         String?
  enrollmentDocSize             Int?
  enrollmentDocBucketName       String?
  enrollmentDocFilePath         String?
  enrollmentDocPublicUrl        String?

  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  application LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("college_verifications")
}

model ParentVerification {
  id            String @id @default(uuid())
  applicationId String @unique

  name              String?
  phone             String?
  contact           String?
  citizenshipNumber String?
  salaryBankName    String?
  bankAccountNumber String?

  // Legacy single salary sheet document — superseded by ParentDocument
  // (SALARY_SHEET type, supports multiple files). Kept for existing data;
  // no longer written to by new uploads.
  salarySheetFileName         String?
  salarySheetOriginalFileName String?
  salarySheetMimeType         String?
  salarySheetSize             Int?
  salarySheetBucketName       String?
  salarySheetFilePath         String?
  salarySheetPublicUrl        String?

  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  application LoanApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  documents   ParentDocument[]

  @@map("parent_verifications")
}

enum ParentDocumentType {
  NID
  PAN_ID
  SALARY_SHEET
}

model ParentDocument {
  id                   String             @id @default(uuid())
  parentVerificationId String
  documentType         ParentDocumentType

  // Editable, parent-facing name for the document (e.g. "March Salary")
  label String?

  fileName         String
  originalFileName String
  mimeType         String
  size             Int
  bucketName       String
  filePath         String
  publicUrl        String
  uploadedAt       DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parentVerification ParentVerification @relation(fields: [parentVerificationId], references: [id], onDelete: Cascade)

  @@index([parentVerificationId])
  @@map("parent_documents")
}

// ─── College Document Templates ───────────────────────────────────────────────

