model Agreement {
  id             String @id @default(uuid())
  createdByEmail String

  // College / Institution
  collegeName        String
  collegeAddress     String?
  collegeRegNo       String?
  collegeAffiliation String?
  collegePhone       String?
  collegeEmail       String?
  collegeWebsite     String?
  logoUrl            String?

  // Document meta
  refNo        String
  issuedDateAD String?
  issuedDateBS String?

  // Student
  studentFullName String
  tuRollNo        String?
  enrollmentNo    String?
  programName     String?
  currentYear     String?
  currentSemester String?
