  shortName String?
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  colleges College[]

  @@map("universities")
}

model College {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?
  // Long-form "About" content (multiple paragraphs) for a future richer
  // About section — distinct from `description`, which stays the short
  // card/summary blurb. Frontend rendering is deferred; schema only for now.
  aboutContent String?
  logoUrl     String?
  bannerUrl   String?

  address      String?
  province     String?
  district     String?
  municipality String?

  universityId String?
  university   University? @relation(fields: [universityId], references: [id], onDelete: SetNull)

  website      String?
