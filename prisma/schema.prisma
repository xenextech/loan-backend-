model EnrollmentCertificate {
  id             String @id @default(uuid())
  createdByEmail String

  // College / Institution
  collegeName        String
  collegeCode        String?
  collegeAddress     String?
  collegeRegNo       String?
  collegeAffiliation String?
  collegePhone       String?
  collegeEmail       String?
  collegeWebsite     String?
  logoUrl            String?

  // Document meta
  refNo        String
  issuedDateAD String?
  issuedDateBS String?

  // Student
  studentFullName String
  tuRollNo        String?
  enrollmentNo    String?
  programName     String?
  currentYear     String?
  currentSemester String?
  academicYearBS  String?
  studentStatus   String?

  // College certifications
  isEnrolled       Boolean  @default(true)
  hasBacklogs      Boolean  @default(false)
  disciplinaryHold Boolean  @default(false)
  feeDueRs         Decimal? @db.Decimal(14, 2)

  // QR / verification
  qrToken     String?
  qrVerifyUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdByEmail])
  @@map("enrollment_certificates")
}

// ─── Dashboard: Disbursement ───────────────────────────────────────────────────

model DisbursementCondition {
  id            String @id @default(cuid())
  applicationId String

  label       String
  status      DisbursementConditionStatus @default(PENDING)
  remarks     String?
  completedAt DateTime?

  completedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("disbursement_conditions")
}

// Credit ledger — the master record created the moment an application is
// approved, tying approval, disbursement, and the EMI schedule together.
// Deliberately doesn't duplicate principal/rate/tenure/disbursed-amount:
// those are read live off LoanApplication/Disbursement via the relations.
model LoanAccount {
  id                String            @id @default(uuid())
  applicationId     String            @unique
  loanAccountNumber String            @unique
  status            LoanAccountStatus @default(ACTIVE)

  // Loan servicing configuration (Credit Manager, post-approval, only
  // enterable once a disbursement exists — see DashboardRepaymentService.
  // configureServicing()). Omitted fields fall back to the application's
  // originally approved values, or — for principal — the actual disbursed
  // amount, when the schedule is (re)generated.
  finalInterestRate Decimal? @db.Decimal(5, 2)
  finalTenureMonths Int?

  // repaymentFrequency is the EMI/installment cadence; interestFrequency is
  // the compounding cadence and is independently settable — null means
  // "compounds at the same cadence as repaymentFrequency" (the pre-existing
  // behavior, and still the common case). When they differ, the nominal
  // rate is converted to an equivalent rate at the payment cadence via
  // common/utils/interest-rate.util.ts before amortizing, rather than
  // teaching the EMI formula two frequencies.
  repaymentFrequency RepaymentFrequency  @default(MONTHLY)
  interestFrequency  RepaymentFrequency?

  // Credit Manager override of the principal used for servicing math —
  // defaults to the actual Disbursement.totalDisbursedAmount when null.
  finalPrincipalAmount Decimal? @db.Decimal(18, 2)

  gracePeriodMonths  Int       @default(0)
  emiStartDate       DateTime?
  firstDueDate       DateTime?
  configuredByUserId String?
  configuredAt       DateTime?
  borrowerNotifiedAt DateTime?

  clearedAt DateTime?

  // Needs Review (Stage 6) — manually raised by the Credit Manager, not
  // auto-triggered by any threshold, since no such threshold was specified.
  reviewReason            String?
  reviewRequestedByUserId String?
  reviewRequestedAt       DateTime?
  reviewResolvedByUserId  String?
  reviewResolvedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("loan_accounts")
}

// Collection & follow-up history (Stage 4) — manual outreach records logged
// by the Credit Manager, distinct from the automated EMI reminder log (which
// lives in the existing Notification table via the daily cron).
model CollectionActivity {
  id              String                 @id @default(uuid())
  applicationId   String
  createdByUserId String
  activityType    CollectionActivityType
  notes           String
  contactedPerson String?

  createdAt DateTime @default(now())

  application LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("collection_activities")
}

model Disbursement {
  id            String @id @default(cuid())
  applicationId String @unique

  status               DisbursementStatus @default(PENDING)
  totalDisbursedAmount Decimal?           @db.Decimal(18, 2)
  initiatedByUserId    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application LoanApplication       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  tranches    DisbursementTranche[]

  @@map("disbursements")
}

model DisbursementTranche {
  id             String @id @default(cuid())
  disbursementId String

  trancheNumber    Int
  amount           Decimal       @db.Decimal(18, 2)
  accountCredited  String?
  status           TrancheStatus @default(PENDING)
  disbursedAt      DateTime?
  commissionAmount Decimal?      @db.Decimal(18, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  disbursement Disbursement @relation(fields: [disbursementId], references: [id], onDelete: Cascade)

  @@index([disbursementId])
  @@map("disbursement_tranches")
}

// ─── Dashboard: EMI schedule ────────────────────────────────────────────────────

model EmiScheduleEntry {
  id            String @id @default(cuid())
  applicationId String

  installmentNumber    Int
  dueDate              DateTime
  emiAmount            Decimal   @db.Decimal(18, 2)
  principalComponent   Decimal   @db.Decimal(18, 2)
  interestComponent    Decimal   @db.Decimal(18, 2)
  outstandingPrincipal Decimal   @db.Decimal(18, 2)
  status               EmiStatus @default(UPCOMING)
  paidAmount           Decimal?  @default(0) @db.Decimal(18, 2)
  paidDate             DateTime?

  // Running penal-interest balance — accrued daily by the cron while this entry
  // is OVERDUE, at (contract interest rate + 2%) simple daily interest on emiAmount.
  penalInterestAccrued Decimal @default(0) @db.Decimal(18, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([dueDate])
  @@index([status])
  @@map("emi_schedule_entries")
}

// ─── Dashboard: Notification templates ─────────────────────────────────────────

model NotificationTemplate {
  id String @id @default(cuid())

  name     String
  channel  NotificationChannel
  subject  String?
  body     String
  isActive Boolean             @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notification_templates")
}

// ─── Dashboard: Document center ────────────────────────────────────────────────

model GeneratedAgreement {
  id            String @id @default(cuid())
  applicationId String

  agreementType    GeneratedAgreementType
  status           GeneratedAgreementStatus @default(DRAFT)
  templateSnapshot Json?
  documentUrl      String?

  generatedByUserId String
  sentToSignAt      DateTime?
  signedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("generated_agreements")
}

// ─── Dashboard: Insurance tracker ──────────────────────────────────────────────

model InsurancePolicy {
  id            String @id @default(cuid())
  applicationId String

  policyNumber  String
  insurer       String
  policyType    String?
  sumInsured    Decimal   @db.Decimal(18, 2)
  premiumAmount Decimal?  @db.Decimal(18, 2)
  startDate     DateTime?
  expiryDate    DateTime

  addedByUserId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([expiryDate])
  @@map("insurance_policies")
}

// ─── Dashboard: Commission management ──────────────────────────────────────────

model CommissionPartner {
  id String @id @default(cuid())

  partnerType  CommissionPartnerType
  name         String
  rateType     CommissionRateType
  rateValue    Decimal               @db.Decimal(10, 4)
  mouReference String?
  isActive     Boolean               @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries CommissionEntry[]

  @@map("commission_partners")
}

model CommissionEntry {
  id            String  @id @default(cuid())
  applicationId String?
  partnerId     String

  amount     Decimal               @db.Decimal(18, 2)
  month      DateTime
  status     CommissionEntryStatus @default(PENDING)
  invoiceRef String?
  paidAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application LoanApplication?  @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  partner     CommissionPartner @relation(fields: [partnerId], references: [id], onDelete: Restrict)

  @@index([applicationId])
  @@index([partnerId])
  @@index([month])
  @@map("commission_entries")
}
